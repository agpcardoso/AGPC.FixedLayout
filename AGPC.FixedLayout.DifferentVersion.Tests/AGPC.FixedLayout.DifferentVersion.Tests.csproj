<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="16.0.1" />
    <PackageReference Include="xunit" Version="2.4.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AGPC.FixedLayout\AGPC.FixedLayout.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\AGPC.FixedLayout.Tests\DTO\OrderDTO.cs" Link="DTO\OrderDTO.cs" />
    <Compile Include="..\AGPC.FixedLayout.Tests\DTO\ProductDTO.cs" Link="DTO\ProductDTO.cs" />
    <Compile Include="..\AGPC.FixedLayout.Tests\DTO\ReportOrdersDTO.cs" Link="DTO\ReportOrdersDTO.cs" />
  </ItemGroup>

  <!-- 
  
  
  This dedicated project keeps the historical package dependency and large comparison out of the normal test suite. 
  
  
  -->
  <ItemGroup>
    <PackageDownload Include="AGPC.FixedLayout" Version="[1.0.0]" />
  </ItemGroup>

  <Target Name="CopyLegacyFixedLayoutForPerformanceTest" AfterTargets="Build">
    <PropertyGroup>
      <LegacyFixedLayoutAssembly>$(NuGetPackageRoot)agpc.fixedlayout\1.0.0\lib\netstandard2.0\AGPC.FixedLayout.dll</LegacyFixedLayoutAssembly>
    </PropertyGroup>
    <Error Condition="!Exists('$(LegacyFixedLayoutAssembly)')" Text="The AGPC.FixedLayout 1.0.0 package must be restored to run the performance comparison." />
    <Copy SourceFiles="$(LegacyFixedLayoutAssembly)" DestinationFolder="$(OutDir)legacy" />
  </Target>

</Project>